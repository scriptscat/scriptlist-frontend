{
  "name": "scriptlist-frontend",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "overrides": {
      "dompurify": "3.4.13",
      "fast-uri": "3.1.5",
      "postcss": "8.5.26"
    }
  },
  "scripts": {
    "prepare": "node scripts/install-git-hooks.mjs",
    "dev": "pnpm run predev && next dev",
    "build": "pnpm run prebuild && next build",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:mock-api": "ts-node --project ./tsconfig.node.json ./tests/e2e/mock-api.ts",
    "lint": "eslint .",
    "lint-fix": "eslint . --fix",
    "check:i18n": "node ./scripts/check-translations.mjs",
    "predev": "ts-node --project ./tsconfig.node.json ./scripts/prebuild.tsx",
    "prebuild": "cross-env NODE_ENV=production ts-node --project ./tsconfig.node.json ./scripts/prebuild.tsx",
    "verify:antd-css": "ts-node --project ./tsconfig.node.json ./scripts/verify-antd-css.ts"
  },
  "dependencies": {
    "@ant-design/charts": "^2.6.7",
    "@ant-design/icons": "6.0.2",
    "@ant-design/nextjs-registry": "^1.3.0",
    "@ant-design/static-style-extract": "^2.1.0",
    "@cago-frame/agents-client": "^0.1.0",
    "@iconify-icons/logos": "^1.2.36",
    "@iconify-icons/mdi": "^1.2.48",
    "@iconify-icons/mingcute": "^1.2.9",
    "@iconify-icons/noto": "^1.2.10",
    "@iconify/react": "^6.0.2",
    "@marsidev/react-turnstile": "^1.6.0",
    "@monaco-editor/react": "^4.7.0",
    "@simplewebauthn/browser": "^13.3.0",
    "@toast-ui/editor": "^3.2.2",
    "@toast-ui/editor-plugin-code-syntax-highlight": "^3.1.0",
    "antd": "^6.6.1",
    "dayjs": "^1.11.23",
    "github-markdown-css": "^5.9.0",
    "marked": "^18.0.11",
    "marked-alert": "^2.1.2",
    "marked-footnote": "^1.4.0",
    "marked-gfm-heading-id": "^4.1.4",
    "monaco-editor": "^0.56.0",
    "next": "16.3.2",
    "next-intl": "^4.13.7",
    "nextjs-toploader": "^3.9.17",
    "prismjs": "^1.30.0",
    "react": "^19.2.8",
    "react-copy-to-clipboard": "^5.1.1",
    "react-device-detect": "^2.2.3",
    "react-dom": "^19.2.8",
    "swr": "^2.5.1",
    "xss": "^1.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.1",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19",
    "@types/react-copy-to-clipboard": "^5.0.7",
    "@types/react-dom": "^19",
    "cross-env": "^7.0.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "postcss": "8.5.26",
    "postcss-selector-parser": "^7.1.5",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "ts-node": "^10.9.2",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  }
}
